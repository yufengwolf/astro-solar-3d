# 依赖
node_modules/

# 构建产物（部署时由 Cloudflare Pages 现场构建；本地 dist 不进仓库）
dist/

# 可选的本地导出目录（npm run sync 的目标，见 sync.config.json）
_export/

# 自检脚本的中间产物
src/.check-tmp/
src/.check-links-tmp/
src/.check-stars-tmp/
src/.gen-tmp/

# 天体直达外链清单：由 gen:links 在 prebuild / predev 时生成
static/links.json
static/links.html

# 截图 / 无头浏览器临时目录
.shots/
.chrome-tmp*/
.edge-tmp*/
.smoke*/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 原始天文数据包（从外部源下载，体积大，不入库；由 npm run build:hyg 读取）
data/raw/

# 本地日志
*.log

# 真机验证截图（仅本地审阅，不入库）
preview-*.png
.tmp/
